# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose "groq" (default), "openai", or "gemini"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# ── API Keys ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Feature Flags ─────────────────────────────────────────────────────────────
SKIP_RULES_VERIFIED=false

# ── Eval Cost Cap ─────────────────────────────────────────────────────────────
EVAL_COST_CAP_USD=1.00

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-deployed-frontend.vercel.app
